# ==============================================================================
# MigrateLift WordPress Plugin - .gitignore
# ==============================================================================

# Node / JavaScript dependencies
node_modules/
.npm/

# Compiled assets: regenerate from src/ with `npm run build`.
# The plugin needs build/ at runtime, so a fresh clone must be built before use.
/build/
*.map

# Release packages (generated via `npm run plugin-zip`)
*.zip
*.tar
*.tar.gz
*.tgz

# Composer / PHP dependencies
vendor/
composer.phar

# Logs & debugging
*.log

# Test, lint & coverage caches
coverage/
.nyc_output/
.phpunit.cache/
.phpunit.result.cache
.phpcs-cache
.eslintcache
.stylelintcache
.cache/

# Environment variables & local configuration
.env
.env.*
!.env.example

# Runtime backups, database dumps & temporary files
migrate-lift-files/
*.sql
*.sql.gz
*.tmp
*.bak
*.orig
*.swp
*.swo
*~

# IDE, editor & agent files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.claude/settings.local.json

# Operating system files
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
